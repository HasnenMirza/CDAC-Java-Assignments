
public class Manager extends Employee {

	Manager(String name, String address, int age, String gender, float salary) {
		super(name, address, age, gender, salary);
	}

	protected float hra;
	
	public void setHra(float hra) {
		
		if(hra<0) {
			System.out.println("Enter valid HRA amount!");
			return;
		}
		this.hra=hra;
	}
	
	public float getHra() {
		return hra;
	}
	
}
